#!/bin/bash
#
# Applies (or removes, or verifies) the two one-line hooks that connect this
# package to Proxmox VE:
#
#   /usr/share/perl5/PVE/API2/Nodes.pm   -> registers the /hpe-ilo API path
#   /usr/share/pve-manager/index.html.tpl -> loads the panel JavaScript
#
# Both files belong to Proxmox packages and are replaced on upgrade, so this
# script is idempotent and is re-run from an apt Post-Invoke hook. It only
# restarts services when it actually changed something.

set -e

# PVE_HPE_ILO_ROOT relocates every path under a prefix, which is what the
# test harness uses to exercise this script without a Proxmox node.
ROOT="${PVE_HPE_ILO_ROOT:-}"

NODES_PM="$ROOT/usr/share/perl5/PVE/API2/Nodes.pm"
INDEX_TPL="$ROOT/usr/share/pve-manager/index.html.tpl"
JS_NAME="pve-hpe-ilo.js"
MARKER="pve-hpe-ilo"
BACKUP_DIR="$ROOT/var/lib/pve-hpe-ilo/backup"

MODE="apply"
QUIET=0

for arg in "$@"; do
    case "$arg" in
	--check)  MODE="check" ;;
	--remove) MODE="remove" ;;
	--quiet)  QUIET=1 ;;
	-h|--help)
	    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
	    echo
	    echo "usage: $(basename "$0") [--check|--remove] [--quiet]"
	    exit 0
	    ;;
	*)
	    echo "unknown argument: $arg" >&2
	    exit 1
	    ;;
    esac
done

say() {
    [ "$QUIET" -eq 1 ] || echo "$@"
}

err() {
    echo "$@" >&2
}

backup_once() {
    # One pristine copy per upgrade cycle: taken whenever the file on disk has
    # no marker, i.e. it is the version Proxmox just installed.
    local file="$1"
    mkdir -p "$BACKUP_DIR"
    cp -a "$file" "$BACKUP_DIR/$(basename "$file").orig"
}

restore_backup() {
    local file="$1"
    local orig="$BACKUP_DIR/$(basename "$file").orig"
    [ -f "$orig" ] && cp -a "$orig" "$file"
}

has_marker() {
    grep -q "$MARKER" "$1" 2>/dev/null
}

patch_nodes_pm() {
    if has_marker "$NODES_PM"; then
	return 1
    fi

    backup_once "$NODES_PM"

    # Insert before the module's trailing "1;". The registration is wrapped in
    # eval so a broken or half-removed install degrades to "tab missing"
    # instead of taking pvedaemon down with it.
    perl -i -0777 -pe '
	my $hook = <<"HOOK";
# BEGIN pve-hpe-ilo -- managed by pve-hpe-ilo-patch, safe to delete
eval {
    require PVE::HPEiLO::API;
    PVE::HPEiLO::API::register();
};
warn "pve-hpe-ilo: failed to register API endpoint: \$\@" if \$\@;
# END pve-hpe-ilo

HOOK
	s/\n1;\s*\z/\n${hook}1;\n/ or die "no trailing 1; in $ARGV\n";
    ' "$NODES_PM" || {
	err "could not insert the API hook into $NODES_PM"
	restore_backup "$NODES_PM"
	return 2
    }

    if ! has_marker "$NODES_PM"; then
	err "API hook did not take effect in $NODES_PM"
	restore_backup "$NODES_PM"
	return 2
    fi

    return 0
}

patch_index_tpl() {
    if has_marker "$INDEX_TPL"; then
	return 1
    fi

    backup_once "$INDEX_TPL"

    # Copy the cache-busting query string off the pvemanagerlib.js tag rather
    # than hardcoding a template variable that may be renamed upstream.
    JS_NAME="$JS_NAME" perl -i -pe '
	if (!$done && m{src="([^"]*?/)pvemanagerlib\.js([^"]*)"}) {
	    my ($dir, $query) = ($1, $2);
	    my $js = $ENV{JS_NAME};
	    $_ .= qq{<script type="text/javascript" src="$dir$js$query"></script> <!-- pve-hpe-ilo -->\n};
	    $done = 1;
	}
    ' "$INDEX_TPL"

    if ! has_marker "$INDEX_TPL"; then
	err "could not find the pvemanagerlib.js script tag in $INDEX_TPL"
	restore_backup "$INDEX_TPL"
	return 2
    fi

    return 0
}

unpatch() {
    local file="$1"
    local orig="$BACKUP_DIR/$(basename "$file").orig"

    if ! has_marker "$file"; then
	return 1
    fi

    if [ -f "$orig" ]; then
	cp -a "$orig" "$file"
	return 0
    fi

    # No backup: strip the marked block in place.
    perl -i -0777 -pe '
	s/^# BEGIN pve-hpe-ilo.*?^# END pve-hpe-ilo\n\n?//ms;
	s/^.*<!-- pve-hpe-ilo -->.*\n//mg;
    ' "$file"

    return 0
}

for f in "$NODES_PM" "$INDEX_TPL"; do
    if [ ! -f "$f" ]; then
	err "$f not found - is this a Proxmox VE node?"
	exit 1
    fi
done

CHANGED=0
FAILED=0

# Each patch function returns 0 when it changed the file, 1 when the hook was
# already there, and 2 on failure. Failures must not be swallowed: a silently
# unpatched node is exactly the bug this script exists to prevent.
run_step() {
    local label="$1"
    shift
    local rc=0
    "$@" || rc=$?
    case "$rc" in
	0) CHANGED=1; say "$label" ;;
	1) ;;
	*) FAILED=1 ;;
    esac
}

case "$MODE" in
    check)
	missing=0
	has_marker "$NODES_PM"  || { err "API hook missing in $NODES_PM"; missing=1; }
	has_marker "$INDEX_TPL" || { err "GUI hook missing in $INDEX_TPL"; missing=1; }
	if [ "$missing" -eq 0 ]; then
	    say "both hooks are in place"
	fi
	exit "$missing"
	;;

    remove)
	run_step "removed API hook from $NODES_PM"  unpatch "$NODES_PM"
	run_step "removed GUI hook from $INDEX_TPL" unpatch "$INDEX_TPL"
	;;

    apply)
	run_step "added API hook to $NODES_PM"  patch_nodes_pm
	run_step "added GUI hook to $INDEX_TPL" patch_index_tpl
	;;
esac

if [ "$CHANGED" -eq 1 ]; then
    if [ -n "$ROOT" ]; then
	say "PVE_HPE_ILO_ROOT is set - not touching services"
    else
	# pvedaemon caches loaded Perl modules; pveproxy caches the rendered
	# index template. Both need a restart for the change to be visible.
	say "restarting pvedaemon and pveproxy"
	systemctl restart pvedaemon pveproxy
    fi
else
    say "nothing to do"
fi

exit "$FAILED"
